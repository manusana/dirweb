---
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import '../styles/global.css';
import dissolve from '../data/dissolve.json';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'dir.sixFilms | Filmmaker & Cover Artist',
	description = 'Portfolio cinematografico de dir.sixFilms: videoclips, portadas, proximos trabajos, merchandising y contacto para contrataciones.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#f4f0e8" id="theme-color" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<script is:inline>
			try {
				const storedTheme = localStorage.getItem('theme');
				const systemTheme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
				const activeTheme = storedTheme || systemTheme;
				document.documentElement.dataset.theme = activeTheme;
				document.querySelector('#theme-color')?.setAttribute('content', activeTheme === 'dark' ? '#11100e' : '#f4f0e8');
			} catch {
				document.documentElement.dataset.theme = 'light';
			}
		</script>
		<title>{title}</title>
	</head>
	<body class="min-h-screen bg-[var(--page-bg)] text-[var(--text)] antialiased selection:bg-[var(--text)] selection:text-[var(--button-text)]">
		<div class="site-background" aria-hidden="true">
			<div class="background-brand">
				<img
					class="intro-logo"
					src="/sixfilms-background.jpg"
					alt=""
					width="1920"
					height="1080"
					loading="eager"
					fetchpriority="high"
					decoding="async"
				/>
			</div>
			<div class="background-dissolve">
				<canvas class="dissolve-canvas" width={dissolve.width} height={dissolve.height}></canvas>
				{dissolve.frames.map((_, index) => (
					<img
						class="dissolve-frame"
						data-dissolve-src={`/background/logo-dissolve-${index}.webp`}
						alt=""
						width={dissolve.width}
						height={dissolve.height}
						decoding="async"
						fetchpriority="low"
					/>
				))}
			</div>
			<div class="background-mesh">
				<div class="mesh-clouds"></div>
			</div>
			<div class="intro-flash"></div>
		</div>
		<div class="site-content min-h-screen">
			<Navbar />
			<main id="contenido">
				<slot />
			</main>
			<Footer />
		</div>
	</body>
</html>

<script>
	import '../scripts/background';
</script>
