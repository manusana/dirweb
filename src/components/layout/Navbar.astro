---
import { Image } from 'astro:assets';
import profilePhoto from '../../assets/profile/dir-sixfilms-profile.jpeg';

const navItems = [
	{ label: 'Inicio', href: '#inicio' },
	{ label: 'Obras', href: '#obras' },
	{ label: 'Contacto', href: '#contacto' },
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-[color:var(--border)] bg-[var(--page-bg)]/95">
	<div class="page-progress" aria-hidden="true"><span class="page-progress-bar"></span></div>
	<a
		href="#contenido"
		class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-full focus:bg-[var(--button-bg)] focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-[var(--button-text)]"
	>
		Saltar al contenido
	</a>
	<nav class="mx-auto flex h-16 w-full max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8" aria-label="Principal">
		<a href="#inicio" class="group inline-flex items-center gap-3" aria-label="Ir a inicio">
			<Image
				src={profilePhoto}
				alt=""
				width={32}
				height={32}
				loading="eager"
				decoding="async"
				class="size-8 rounded-full border border-[color:var(--border-strong)] bg-[var(--surface)] object-cover transition-transform duration-200 group-hover:scale-[1.03] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
			/>
			<span class="font-heading text-sm font-semibold text-[var(--text)]">dir.sixFilms</span>
		</a>

		<div class="hidden items-center gap-1 md:flex">
			{
				navItems.map((item) => (
					<a
						href={item.href}
						class="rounded-full px-4 py-2 font-sans text-xs text-[var(--muted)] transition-colors duration-200 hover:bg-[var(--surface)] hover:text-[var(--text)]"
					>
						{item.label}
					</a>
				))
			}
		</div>

		<div class="flex items-center gap-2">
			<button
				type="button"
				id="theme-toggle"
				class="inline-grid size-10 place-items-center rounded-full border border-[color:var(--border-strong)] bg-[var(--surface)] text-[var(--text)] transition duration-200 hover:scale-[1.03] hover:bg-[var(--surface-strong)] focus:outline-none focus:ring-2 focus:ring-[var(--text)] focus:ring-offset-2 focus:ring-offset-[var(--page-bg)] motion-reduce:hover:scale-100"
				aria-label="Cambiar a modo oscuro"
				aria-pressed="false"
			>
				<svg viewBox="0 0 24 24" class="size-5" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
					<path d="M7 8.5h1.4l1-1.5h5.2l1 1.5H17a3 3 0 0 1 3 3v3.5a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3v-3.5a3 3 0 0 1 3-3Z" />
					<circle cx="12" cy="13.5" r="3.1" />
					<path d="M17.5 10.5h.01" />
				</svg>
			</button>
			<a
				href="#contacto"
				class="inline-flex h-10 items-center rounded-full border border-[color:var(--border-strong)] bg-[var(--button-bg)] px-4 font-sans text-xs font-semibold text-[var(--button-text)] transition duration-200 hover:scale-[1.03] hover:bg-[var(--button-hover)] focus:outline-none focus:ring-2 focus:ring-[var(--text)] focus:ring-offset-2 focus:ring-offset-[var(--page-bg)] motion-reduce:hover:scale-100"
			>
				Contratar
			</a>
		</div>
	</nav>
</header>

<script is:inline>
	const toggle = document.querySelector('#theme-toggle');
	const themeColor = document.querySelector('#theme-color');

	function setTheme(theme) {
		document.documentElement.dataset.theme = theme;
		try {
			localStorage.setItem('theme', theme);
		} catch {}
		themeColor?.setAttribute('content', theme === 'dark' ? '#11100e' : '#f4f0e8');
		if (toggle) {
			toggle.setAttribute('aria-pressed', theme === 'dark' ? 'true' : 'false');
			toggle.setAttribute('aria-label', theme === 'dark' ? 'Cambiar a modo claro' : 'Cambiar a modo oscuro');
		}
	}

	setTheme(document.documentElement.dataset.theme || 'light');
	toggle?.addEventListener('click', () => {
		setTheme(document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark');
	});
</script>

<script>
	import '../../scripts/scroll-progress';
</script>
